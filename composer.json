{
    "name": "labidi/recaptcha",
    "description": "Google reCAPTCHA (v2 checkbox, v2 invisible and v3) integration for Laravel, with Blade and Inertia.js support.",
    "keywords": ["laravel", "recaptcha", "captcha", "google-recaptcha", "inertia", "validation", "spam"],
    "homepage": "https://github.com/labidi/recaptcha",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Saddem Labidi",
            "email": "labidi.saddem@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.40 || ^13.0",
        "illuminate/http": "^12.40 || ^13.0",
        "illuminate/routing": "^12.40 || ^13.0",
        "illuminate/support": "^12.40 || ^13.0",
        "illuminate/validation": "^12.40 || ^13.0",
        "illuminate/view": "^12.40 || ^13.0"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^2.0 || ^3.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.8 || ^11.0",
        "pestphp/pest": "^4.2 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Labidi\\Recaptcha\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Labidi\\Recaptcha\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "test:lint": "vendor/bin/pint --test",
        "test:types": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Labidi\\Recaptcha\\RecaptchaServiceProvider"
            ],
            "aliases": {
                "Recaptcha": "Labidi\\Recaptcha\\Facades\\Recaptcha"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
